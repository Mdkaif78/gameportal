{% extends 'base.html.twig' %}
{% block title %}{{ game ? 'Edit game' : 'Add game' }} | Game Portal{% endblock %}
{% block content %}<h1>{{ game ? 'Edit game' : 'Add a game' }}</h1>
{% if errors %}<div class="alert alert-danger"><ul class="mb-0">{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
<form method="post" action="save-game.php" class="card card-body gap-3">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ game.game_id|default('') }}">
  <div><label for="game_name" class="form-label">Game name</label><input class="form-control" id="game_name" name="game_name" maxlength="120" required value="{{ values.game_name|default(game.game_name|default('')) }}"></div>
  <div><label for="game_description" class="form-label">Description</label><textarea class="form-control" id="game_description" name="game_description" rows="5" maxlength="5000">{{ values.game_description|default(game.game_description|default('')) }}</textarea></div>
  <div class="row"><div class="col-md-6"><label for="released_date" class="form-label">Release date</label><input class="form-control" type="date" id="released_date" name="released_date" required value="{{ values.released_date|default(game.released_date|default('')) }}"></div><div class="col-md-6"><label for="rating" class="form-label">Rating (0–100)</label><input class="form-control" type="number" id="rating" name="rating" min="0" max="100" required value="{{ values.rating|default(game.rating|default('')) }}"></div></div>
  <div><button class="btn btn-primary">{{ game ? 'Save changes' : 'Add game' }}</button> <a class="btn btn-outline-secondary" href="index.php">Cancel</a></div>
</form>{% endblock %}
