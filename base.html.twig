<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Game Portal{% endblock %}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-yEPZ7jP9S0QKiUQ0m3jjsO4ProIW7wvR9gXkI7JOGa2XVsw53Yke2bsdkBbjmmiX" crossorigin="anonymous">
  <link href="assets/style.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container">
  <a class="navbar-brand" href="index.php">Game Portal</a>
  <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
  <div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav ms-auto">
    <li class="nav-item"><a class="nav-link" href="index.php">Browse</a></li>
    {% if logged_in %}
      <li class="nav-item"><a class="nav-link" href="game-form.php">Add a game</a></li>
      <li class="nav-item"><form method="post" action="logout.php" class="d-inline"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="nav-link border-0 bg-transparent">Log out ({{ username }})</button></form></li>
    {% else %}<li class="nav-item"><a class="nav-link" href="login.php">Log in</a></li>{% endif %}
  </ul></div>
</div></nav>
<main class="container py-4">
  {% if flash %}<div class="alert alert-info" role="status">{{ flash }}</div>{% endif %}
  {% block content %}{% endblock %}
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/js/bootstrap.bundle.min.js" integrity="sha384-WyOxWvTyr1QaMPfiPJSv76iReVthorl5uWlFtZPyK0IEB0hGzo9y5Bp9mYanr8Bu" crossorigin="anonymous"></script>
{% block scripts %}{% endblock %}
</body></html>
