{% extends 'base.html.twig' %}
{% block title %}Log in | Game Portal{% endblock %}
{% block content %}<div class="auth-card"><h1 class="h3">Log in</h1><p class="text-secondary">Sign in to add, edit, or delete catalogue records.</p>
{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
<form method="post" action="login.php" class="d-grid gap-3"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><div><label class="form-label" for="username">Username</label><input class="form-control" id="username" name="username" autocomplete="username" maxlength="80" required></div><div><label class="form-label" for="password">Password</label><input class="form-control" type="password" id="password" name="password" autocomplete="current-password" required></div>
{% if captcha_enabled %}<div><label class="form-label" for="captcha">Security check: {{ captcha_question }}</label><input class="form-control" type="number" id="captcha" name="captcha" required><div class="form-text">Enter the answer to the addition question.</div></div>{% endif %}<button class="btn btn-primary">Log in</button></form>
{% if allow_registration %}<p class="mt-3 mb-0">New here? <a href="register.php">Create an account</a>.</p>{% endif %}</div>{% endblock %}
