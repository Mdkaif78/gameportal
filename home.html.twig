{% extends 'base.html.twig' %}
{% block title %}Browse games | Game Portal{% endblock %}
{% block content %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><h1>Game catalogue</h1><p class="text-secondary mb-0">Browse and filter the collection.</p></div>{% if logged_in %}<a class="btn btn-primary" href="game-form.php">Add a game</a>{% endif %}</div>
<form id="filters" class="card card-body mb-3" role="search">
  <div class="row g-3 align-items-end">
    <div class="col-md-5"><label class="form-label" for="q">Game name</label><input class="form-control" id="q" name="q" maxlength="120" placeholder="e.g. Stardew Valley"></div>
    <div class="col-md-3"><label class="form-label" for="year">Release year</label><input class="form-control" id="year" name="year" type="number" min="1950" max="2100" placeholder="e.g. 2023"></div>
    <div class="col-md-2"><label class="form-label" for="min_rating">Minimum rating</label><input class="form-control" id="min_rating" name="min_rating" type="number" min="0" max="100" placeholder="0–100"></div>
    <div class="col-md-2"><button class="btn btn-outline-secondary w-100" type="reset">Clear filters</button></div>
  </div>
</form>
<p id="result-count" class="small text-secondary" aria-live="polite">{{ games|length }} games</p>
<div id="games" class="row g-3">
{% for game in games %}<div class="col-md-6 col-lg-4"><article class="card h-100"><div class="card-body"><div class="d-flex justify-content-between gap-2"><h2 class="h5">{{ game.game_name }}</h2><span class="badge text-bg-primary align-self-start">{{ game.rating }}/100</span></div><p class="small text-secondary">Released {{ game.released_date }}</p><p>{{ game.game_description|length > 180 ? game.game_description|slice(0, 180) ~ '…' : game.game_description }}</p><a href="game.php?id={{ game.game_id }}" class="btn btn-sm btn-outline-primary">Details</a></div></article></div>
{% else %}<div class="col"><p class="text-secondary">No games found. {% if logged_in %}<a href="game-form.php">Add the first one.</a>{% endif %}</p></div>{% endfor %}
</div>
{% endblock %}
{% block scripts %}<script src="assets/search.js" defer></script>{% endblock %}
