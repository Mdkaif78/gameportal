{% extends 'base.html.twig' %}{% block title %}Create account | Game Portal{% endblock %}{% block content %}<div class="auth-card"><h1 class="h3">Create account</h1>{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}<form method="post" class="d-grid gap-3"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><div><label class="form-label" for="username">Username</label><input class="form-control" id="username" name="username" minlength="3" maxlength="50" autocomplete="username" required></div><div><label class="form-label" for="email">Email</label><input class="form-control" id="email" name="email" type="email" maxlength="254" autocomplete="email" required></div><div><label class="form-label" for="password">Password</label><input class="form-control" id="password" name="password" type="password" minlength="12" autocomplete="new-password" required><div class="form-text">Use at least 12 characters.</div></div><button class="btn btn-primary">Create account</button></form></div>{% endblock %}
