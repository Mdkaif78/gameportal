{% extends 'base.html.twig' %}
{% block title %}{{ game.game_name }} | Game Portal{% endblock %}
{% block content %}<article class="card"><div class="card-body"><a href="index.php" class="small">← Back to catalogue</a><h1 class="mt-3">{{ game.game_name }}</h1><p class="text-secondary">Released {{ game.released_date }} · Rating {{ game.rating }}/100</p><p class="description">{{ game.game_description }}</p>
{% if logged_in %}<div class="d-flex gap-2"><a class="btn btn-primary" href="game-form.php?id={{ game.game_id }}">Edit</a><form method="post" action="delete-game.php" class="delete-form"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ game.game_id }}"><button class="btn btn-outline-danger">Delete</button></form></div>{% endif %}</div></article>{% endblock %}
{% block scripts %}<script src="assets/delete-confirm.js" defer></script>{% endblock %}
